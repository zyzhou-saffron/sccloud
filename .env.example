# ===== scCloud 一键部署环境变量 =====
# start.sh / setup-wizard 会自动生成 .env + ./secrets/
# 敏感项（DB/JWT/Redis/管理员密码）只放 secrets/，不进本文件明文。

# ---- 对外入口 ----
WEB_PORT=8080
WEB_BIND_ADDRESS=0.0.0.0
# rootless 叠加层默认 127.0.0.1，见 docker-compose.rootless.yml

# ---- 预构建镜像 ----
# 默认 GHCR。国内可改 ACR（需 CI 配置 ALIYUN_ACR_* 并成功 mirror）：
#   FRONTEND_IMAGE=registry.cn-hangzhou.aliyuncs.com/<namespace>/sccloud-frontend:latest
#   BACKEND_IMAGE=registry.cn-hangzhou.aliyuncs.com/<namespace>/sccloud-backend:latest
#   R_ENGINE_IMAGE=registry.cn-hangzhou.aliyuncs.com/<namespace>/sccloud-r-engine:latest
FRONTEND_IMAGE=ghcr.io/zyzhou-saffron/sccloud-frontend:latest
BACKEND_IMAGE=ghcr.io/zyzhou-saffron/sccloud-backend:latest
R_ENGINE_IMAGE=ghcr.io/zyzhou-saffron/sccloud-r-engine:latest

# ---- MariaDB（非密钥）----
DB_NAME=sccloud_v2
DB_USER=sccloud_app
# DB_PASS / DB_ROOT_PASS → ./secrets/db-password 与 db-root-password

# ---- JWT（非密钥）----
# JWT_SECRET → ./secrets/jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- Redis ----
# 密码 → ./secrets/redis-password
# setup-wizard 会写入 R_REDIS_URL=redis://:<pass>@redis:6379/0 供 R 引擎使用
# R_REDIS_URL=

# ---- 存储与上传 ----
PROJECTS_ROOT=/data/projects
MAX_UPLOAD_SIZE_GB=30

# ---- R / 资源 ----
R_ENGINE_TIMEOUT=86400
R_ENGINE_MEM_LIMIT=16g
R_WORKER_MEM_LIMIT=32g
WORKER_MEM_CAP_GB=32
WEB_MEM_LIMIT=256m
FRONTEND_MEM_LIMIT=512m
BACKEND_MEM_LIMIT=2g
DB_MEM_LIMIT=1g
REDIS_MEM_LIMIT=512m

# ---- 首次空库管理员 ----
BOOTSTRAP_ADMIN_USER=admin
# BOOTSTRAP_ADMIN_PASSWORD → ./secrets/bootstrap-admin-password（默认 admin123）

# ---- 部署环境 ----
ENVIRONMENT=production

# ---- Compose 文件（可选 rootless）----
# COMPOSE_FILE=docker-compose.yml:docker-compose.rootless.yml
