# ===== scCloud 一键部署环境变量 =====
# start.sh / setup-wizard 会自动生成 .env；也可: cp .env.example .env

# ---- 对外入口 ----
WEB_PORT=8080
WEB_BIND_ADDRESS=0.0.0.0

# ---- 预构建镜像（GHCR；可用 start.sh --build 强制本地构建）----
FRONTEND_IMAGE=ghcr.io/zyzhou-saffron/sccloud-frontend:latest
BACKEND_IMAGE=ghcr.io/zyzhou-saffron/sccloud-backend:latest
R_ENGINE_IMAGE=ghcr.io/zyzhou-saffron/sccloud-r-engine:latest

# ---- MariaDB ----
DB_NAME=sccloud_v2
DB_USER=sccloud_app
DB_PASS=CHANGE_ME_strong_password_here
DB_ROOT_PASS=CHANGE_ME_root_password

# ---- JWT ----
# 生成: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- 存储与上传 ----
PROJECTS_ROOT=/data/projects
MAX_UPLOAD_SIZE_GB=30

# ---- R / 资源 ----
R_ENGINE_TIMEOUT=86400
R_ENGINE_MEM_LIMIT=16g
R_WORKER_MEM_LIMIT=32g
WORKER_MEM_CAP_GB=32

# ---- 首次空库自动创建管理员（仅 users 表为空时）----
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123

# ---- 部署环境 ----
ENVIRONMENT=production
